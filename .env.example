# Copy to .env. Docker Compose reads it.
#
# Production (compose.yaml alone): create the keys file first, then start the proxy.
#   statelock keygen --agent-id my_agent --append keys.yaml   # the key is printed on stderr
#   docker compose up -d --build
#
# Development (demo pages, debug output, demo agents, tests): uncomment the next line
# to use compose.dev.yaml too. It uses the public dev keys in docker/dev-keys.yaml.
COMPOSE_FILE=compose.yaml
# COMPOSE_FILE=compose.yaml:compose.dev.yaml

# Host binding for the proxy port (container port is 8000).
STATELOCK_BIND_HOST=127.0.0.1
STATELOCK_HOST_PORT=8010
# API keys file for compose.yaml (hashes only). It must exist before `docker compose up`.
STATELOCK_KEYS_FILE=./keys.yaml
# Chromium sandbox (compose default 1). Set 0 only on hosts that cannot use docker/seccomp_profile.json.
# STATELOCK_CHROMIUM_SANDBOX=0
