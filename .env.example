# Copy to .env first: cp .env.example .env. compose.yaml needs it (env_file: .env).
# Docker Compose reads it for the variables below, and passes it to the proxy container,
# so any STATELOCK_* setting from the README's Configuration table can be set here.
# The policy, artifact and keys paths are set in the compose files and override .env.
#
# Production (compose.yaml alone): create the keys file first, then start the proxy.
#   statelock keygen --agent-id my_agent --append keys.yaml   # the key is printed on stderr
#   docker compose up -d --build
#
# Development (demo pages, debug output, demo agents, tests): use the second COMPOSE_FILE
# line instead of the first, so plain `docker compose` uses compose.dev.yaml too (or pass
# -f compose.yaml -f compose.dev.yaml). It uses the public dev keys in docker/dev-keys.yaml.
COMPOSE_FILE=compose.yaml
# COMPOSE_FILE=compose.yaml:compose.dev.yaml

# Host binding for the proxy port (container port is 8000).
STATELOCK_BIND_HOST=127.0.0.1
STATELOCK_HOST_PORT=8010
# API keys file for compose.yaml (hashes only). It must exist before `docker compose up`.
STATELOCK_KEYS_FILE=./keys.yaml
# Chromium sandbox (compose default 1). Set 0 only on hosts that cannot use docker/seccomp_profile.json.
# STATELOCK_CHROMIUM_SANDBOX=0

# Proxy settings, with their defaults. Uncomment to change. The full list is in the
# README, Configuration.
# STATELOCK_LOG_LEVEL=INFO
# Visual checks (visual_assert): a litellm model name, and its key or local endpoint.
# STATELOCK_PERCEPTION_MODEL=
# STATELOCK_PERCEPTION_API_KEY=
# STATELOCK_PERCEPTION_API_BASE=
# STATELOCK_PERCEPTION_LOCAL_ONLY=false
# Seconds a session URL stays usable (at most 3600).
# STATELOCK_SESSION_URL_TTL=300
# Seconds a paused action waits for a reviewer.
# STATELOCK_REVIEW_TIMEOUT=300
# Seconds Chromium has to start and answer on its CDP pipe.
# STATELOCK_CHROMIUM_START_TIMEOUT=10
# Seconds each of Statelock's own CDP commands may take.
# STATELOCK_CDP_COMMAND_TIMEOUT=5
# Statelock.fetch requests (request_access) running at once in one session.
# STATELOCK_MAX_CONCURRENT_REQUESTS=4
# Upload and download limits, in bytes (100 MiB per file, 500 MiB per session).
# STATELOCK_UPLOAD_MAX_FILE_BYTES=104857600
# STATELOCK_UPLOAD_MAX_SESSION_BYTES=524288000
# STATELOCK_DOWNLOAD_MAX_FILE_BYTES=104857600
# STATELOCK_DOWNLOAD_MAX_SESSION_BYTES=524288000

# Demo only (compose.dev.yaml): the local vision model the vlm profile pulls and tests.
# DEMO_VLM_MODEL=qwen2.5vl:3b
# perception-tests prints the model's answers and checks only their form; true also requires correct answers.
# DEMO_VLM_CHECK_ANSWERS=false
